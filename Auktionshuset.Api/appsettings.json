{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672
  },
  "Authentication": {
    "Issuer": "Auktionshuset.Api",
    "Audience": "Auktionshuset.Client",
    "AccessTokenLifetimeMinutes": 30,
    "RefreshTokenLifetimeDays": 7
  },
  "AllowedHosts": "*",
  "MessagingOperations": {
    "RunWorkers": true,
    "RunMaintenance": true,
    "OutboxRetentionDays": 30,
    "CleanupBatchSize": 1000,
    "MaintenanceIntervalSeconds": 60,
    "StatusSampleIntervalSeconds": 15,
    "WorkerStaleAfterSeconds": 120,
    "BacklogWarningAfterSeconds": 300,
    "StartupGraceSeconds": 30
  }
}
