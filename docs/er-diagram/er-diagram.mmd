erDiagram
    direction TB
    %% PK=primary key; FK=foreign key; UK=single-column unique index.
    %% NULL/NOT NULL reflect the EF model; C# required is not SQL NOT NULL.
    %% U1-del etc. identify parts of a composite unique index within a table.
    %% Solid=identifying; dashed=non-identifying. All edges are real database FKs.
    %% Invoice is legacy; Outbox_ikke_EF_mappet is a C# class, not a database table.
    %% Physical cardinality includes unique FK indexes even when EF uses WithMany.

    AuctionHouse {
        Guid AuctionHouseId PK "NOT NULL; EF:OnAdd"
        string Address "NOT NULL"
        string AuctionHouseName "NOT NULL"
        int CVRNumber "NOT NULL"
        string Email "NOT NULL"
        string PhoneNumber "NOT NULL"
    }

    Employee {
        Guid EmployeeId PK "NOT NULL; EF:OnAdd"
        string Address "NOT NULL; max=200"
        Guid AuctionHouseId FK "NOT NULL"
        DateOnly BirthDate "NOT NULL"
        string FirstName "NOT NULL; max=80"
        string LastName "NOT NULL; max=80"
    }

    Auction {
        Guid AuctionId PK "NOT NULL; EF:OnAdd"
        Guid AuctionHouseId FK "NOT NULL"
        long AuctionNumber UK "NULL"
        string AuctionStatus "NOT NULL; max=32"
        DateTime ClosedAtTime "NULL"
        Guid EmployeeId FK "NULL"
        DateTime EndedAt "NULL"
        string Name "NOT NULL; max=120"
        DateTime StartedAtTime "NULL"
        DateTime StartsAt "NOT NULL"
    }

    Lot {
        Guid LotId PK "NOT NULL; EF:OnAdd"
        Guid AuctionHouseId FK "NOT NULL"
        string Category "NOT NULL"
        string Description "NOT NULL"
        decimal EstimatedValue "NOT NULL"
        string ImageFileName "NULL; max=128"
        string Name "NOT NULL"
        int Quantity "NOT NULL"
        List_string Tags "NOT NULL; jsonb"
    }

    AuctionLot {
        Guid AuctionLotId PK "NOT NULL; EF:OnAdd"
        Guid AuctionId FK "NOT NULL; U1-del"
        DateTime ClosedAtTime "NULL"
        Guid CurrentHighestBidId FK "NULL"
        Guid LotId FK "NOT NULL; U1-del"
        bool OpenForBids "NOT NULL"
        int Quantity "NOT NULL"
        decimal StartingPrice "NOT NULL; numeric(18,2)"
    }

    Customers {
        Guid CustomerId PK "NOT NULL; EF:OnAdd"
        string Address "NOT NULL"
        DateOnly BirthDate "NOT NULL"
        string Email "NOT NULL"
        string FirstName "NOT NULL"
        string LastName "NOT NULL"
        string PhoneNumber "NOT NULL"
    }

    AuctionRegistrations {
        Guid AuctionId PK, FK "NOT NULL; sammensat PK"
        Guid CustomerId PK, FK "NOT NULL; sammensat PK"
        DateTime RegisteredAt "NOT NULL"
    }

    Device {
        Guid DeviceId PK "NOT NULL; EF:OnAdd"
        Guid AuctionHouseId FK "NOT NULL"
        int DeviceNumber "NOT NULL"
        string Status "NOT NULL"
    }

    DeviceSessions {
        Guid DeviceSessionId PK "NOT NULL; EF:OnAdd"
        Guid AuctionId FK "NOT NULL"
        Guid CustomerId FK "NOT NULL"
        Guid DeviceId FK "NOT NULL"
        DateTime EndedAt "NULL"
        DateTime StartedAt "NOT NULL"
    }

    Bids {
        Guid BidId PK "NOT NULL; EF:OnAdd"
        decimal Amount "NOT NULL"
        Guid AuctionLotId FK "NOT NULL; U1-del"
        Guid CustomerId FK "NOT NULL"
        Guid DeviceSessionId FK "NULL"
        DateTime PlacedAt "NOT NULL"
        int SequenceNumber "NOT NULL; U1-del"
    }

    BidCommandKeys {
        Guid BidCommandKeyId PK "NOT NULL; EF:OnAdd"
        bool Accepted "NOT NULL"
        Guid AuctionLotId "NOT NULL"
        Guid BidId "NULL"
        decimal CurrentPrice "NOT NULL; numeric(18,2)"
        Guid CustomerId FK "NOT NULL; U1-del"
        Guid DeviceSessionId "NULL"
        string ErrorCode "NULL; max=64"
        DateTime ProcessedAt "NOT NULL"
        Guid RequestId "NOT NULL; U1-del"
        decimal RequestedAmount "NOT NULL; numeric(18,2)"
        int SequenceNumber "NULL"
    }

    LoginUsers {
        Guid UserId PK "NOT NULL; EF:OnAdd"
        Guid CustomerId FK, UK "NULL"
        string Email UK "NOT NULL"
        Guid EmployeeId FK, UK "NULL"
        bool IsActive "NOT NULL; default=true; EF:OnAdd"
        string PasswordHash "NOT NULL"
        string Role "NOT NULL"
        int SessionVersion "NOT NULL"
    }

    AuctionInvoices {
        Guid Id PK "NOT NULL; EF:OnAdd"
        Guid AuctionId FK "NOT NULL; U1-del"
        string AuctionName "NOT NULL"
        string Currency "NOT NULL"
        string CustomerAddress "NOT NULL"
        string CustomerEmail "NOT NULL"
        Guid CustomerId FK "NOT NULL; U1-del"
        string CustomerName "NOT NULL"
        decimal HammerTotal "NOT NULL; numeric(20,2)"
        DateTime IssuedAt "NOT NULL"
        string Number UK "NOT NULL"
        decimal PaidAmount "NULL; numeric(20,2)"
        DateTime PaidAt "NULL"
        string PaidByName "NULL"
        Guid PaidByUserId "NULL"
        string PaymentMethod "NULL"
        string PaymentTerms "NOT NULL"
        decimal PremiumPercent "NOT NULL; numeric(7,4)"
        decimal PremiumTotal "NOT NULL; numeric(20,2)"
        string SellerAddress "NOT NULL"
        int SellerCvr "NOT NULL"
        string SellerEmail "NOT NULL"
        string SellerName "NOT NULL"
        long Sequence UK "NOT NULL"
        decimal Total "NOT NULL; numeric(20,2)"
        decimal VatPercent "NOT NULL; numeric(7,4)"
        decimal VatTotal "NOT NULL; numeric(20,2)"
    }

    AuctionInvoiceLines {
        Guid Id PK "NOT NULL; EF:OnAdd"
        Guid AuctionLotId FK, UK "NOT NULL"
        DateTime CollectedAt "NULL"
        string CollectedByName "NULL"
        Guid CollectedByUserId "NULL"
        string Description "NOT NULL"
        decimal HammerPrice "NOT NULL; numeric(20,2)"
        decimal HammerVat "NOT NULL; numeric(20,2)"
        Guid InvoiceId FK "NOT NULL"
        string Name "NOT NULL"
        decimal Premium "NOT NULL; numeric(20,2)"
        decimal PremiumVat "NOT NULL; numeric(20,2)"
        int Quantity "NOT NULL"
        decimal Total "NOT NULL; numeric(20,2)"
        Guid WinningBidId FK, UK "NOT NULL"
        DateTime WonAt "NOT NULL"
    }

    Invoice {
        Guid InvoiceId PK "NOT NULL; EF:OnAdd; legacy"
        Guid AuctionLotId FK "NOT NULL"
        Guid CustomerId FK "NOT NULL"
        DateTime InvoiceDateTime "NOT NULL"
        int InvoiceNumber "NOT NULL"
        string Status "NOT NULL"
        Guid WinningBidId FK "NOT NULL"
    }

    AspNetRoleClaims {
        int Id PK "NOT NULL; EF:OnAdd"
        string ClaimType "NULL"
        string ClaimValue "NULL"
        string RoleId FK "NOT NULL"
    }

    AspNetRoles {
        string Id PK "NOT NULL"
        string ConcurrencyStamp "NULL; concurrency"
        string Name "NULL; max=256"
        string NormalizedName UK "NULL; max=256"
    }

    AspNetUserClaims {
        int Id PK "NOT NULL; EF:OnAdd"
        string ClaimType "NULL"
        string ClaimValue "NULL"
        string UserId FK "NOT NULL"
    }

    AspNetUserLogins {
        string LoginProvider PK "NOT NULL; sammensat PK"
        string ProviderKey PK "NOT NULL; sammensat PK"
        string ProviderDisplayName "NULL"
        string UserId FK "NOT NULL"
    }

    AspNetUserRoles {
        string UserId PK, FK "NOT NULL; sammensat PK"
        string RoleId PK, FK "NOT NULL; sammensat PK"
    }

    AspNetUsers {
        string Id PK "NOT NULL"
        int AccessFailedCount "NOT NULL"
        string ConcurrencyStamp "NULL; concurrency"
        string Email "NULL; max=256"
        bool EmailConfirmed "NOT NULL"
        bool LockoutEnabled "NOT NULL"
        DateTimeOffset LockoutEnd "NULL"
        string NormalizedEmail "NULL; max=256"
        string NormalizedUserName UK "NULL; max=256"
        string PasswordHash "NULL"
        string PhoneNumber "NULL"
        bool PhoneNumberConfirmed "NOT NULL"
        string SecurityStamp "NULL"
        bool TwoFactorEnabled "NOT NULL"
        string UserName "NULL; max=256"
    }

    AspNetUserTokens {
        string UserId PK, FK "NOT NULL; sammensat PK"
        string LoginProvider PK "NOT NULL; sammensat PK"
        string Name PK "NOT NULL; sammensat PK"
        string Value "NULL"
    }

    BillingSequences {
        int Id PK "NOT NULL"
        long LastAuction "NOT NULL"
        long LastInvoice "NOT NULL"
    }

    RefreshTokens {
        Guid Id PK "NOT NULL; EF:OnAdd"
        DateTimeOffset CreatedAt "NOT NULL"
        DateTimeOffset ExpiresAt "NOT NULL"
        Guid FamilyId "NOT NULL"
        DateTimeOffset FamilyRevokedAt "NULL"
        Guid ReplacedByTokenId "NULL"
        DateTimeOffset RevokedAt "NULL"
        int SessionVersion "NOT NULL"
        string TokenHash UK "NOT NULL; max=64"
        Guid UserId "NOT NULL"
    }

    StoredLotImages {
        string FileName PK "NOT NULL; max=128"
        byte[] Content "NOT NULL"
        string ContentType "NOT NULL; max=32"
    }

    OutboxMessages {
        Guid OutboxId PK "NOT NULL; EF:OnAdd"
        int Attempts "NOT NULL"
        string Error "NULL"
        string EventType "NOT NULL"
        DateTime LeaseExpiresAtTime "NULL"
        Guid LeaseToken "NULL"
        DateTime NextAttemptAtTime "NOT NULL; default=CURRENT_TIMESTAMP; EF:OnAdd"
        DateTime OccurredAtTime "NOT NULL"
        string Payload "NOT NULL"
        DateTime ProcessedAtTime "NULL"
        DateTime QuarantinedAtTime "NULL"
    }

    InboxMessages {
        Guid InboxId PK "NOT NULL; EF:OnAdd"
        int Attempts "NOT NULL; default=0; EF:OnAdd"
        string ConsumerName "NOT NULL; U1-del"
        string Error "NULL"
        Guid EventId "NULL"
        string EventType "NOT NULL"
        DateTime InboxQuarantinedAtTime "NULL"
        DateTime LeaseExpiresAtTime "NULL"
        Guid LeaseToken "NULL"
        string MessageKey "NOT NULL; U1-del"
        DateTime NextAttemptAtTime "NOT NULL; default=CURRENT_TIMESTAMP; EF:OnAdd"
        byte[] Payload "NOT NULL"
        DateTime ProcessedAtTime "NULL"
        DateTime ReceivedAtTime "NOT NULL; default=CURRENT_TIMESTAMP; EF:OnAdd"
        string TransportMessageId "NULL"
    }

    MessageReplayAudits {
        Guid ReplayId PK "NOT NULL; EF:OnAdd"
        string ActorId "NOT NULL; max=200"
        Guid EventId "NULL"
        Guid MessageId "NOT NULL"
        string Pipeline "NOT NULL; max=10"
        int PreviousAttempts "NOT NULL"
        string PreviousError "NULL"
        string Reason "NOT NULL; max=500"
        DateTime RequestedAtTime "NOT NULL"
    }

    Outbox_ikke_EF_mappet {
        Guid OutboxId "C# required; IKKE EF-MAPPET"
        string EventType "C# required; IKKE EF-MAPPET"
        string Content "C# required; IKKE EF-MAPPET"
        DateTime OccurredAtTime "C# required; IKKE EF-MAPPET"
        DateTime ProcessedAtTime "C# required; nullable; IKKE EF-MAPPET"
    }

    AuctionHouse ||..o{ Employee : "AuctionHouseId; Restrict"
    AuctionHouse ||..o{ Auction : "AuctionHouseId; Restrict"
    Employee o|..o{ Auction : "EmployeeId; Restrict"
    AuctionHouse ||..o{ Lot : "AuctionHouseId; Restrict"
    Auction ||..o{ AuctionLot : "AuctionId; Cascade"
    Bids o|..o{ AuctionLot : "CurrentHighestBidId; SetNull"
    Lot ||..o{ AuctionLot : "LotId; Restrict"
    Auction ||--o{ AuctionRegistrations : "AuctionId; Cascade"
    Customers ||--o{ AuctionRegistrations : "CustomerId; Cascade"
    AuctionHouse ||..o{ Device : "AuctionHouseId; Restrict"
    Auction ||..o{ DeviceSessions : "AuctionId; Restrict"
    Customers ||..o{ DeviceSessions : "CustomerId; Restrict"
    Device ||..o{ DeviceSessions : "DeviceId; Restrict"
    AuctionLot ||..o{ Bids : "AuctionLotId; Restrict"
    Customers ||..o{ Bids : "CustomerId; Restrict"
    DeviceSessions o|..o{ Bids : "DeviceSessionId; Restrict"
    Customers ||..o{ BidCommandKeys : "CustomerId; Restrict"
    Customers o|..o| LoginUsers : "CustomerId; Cascade"
    Employee o|..o| LoginUsers : "EmployeeId; Restrict"
    Auction ||..o{ AuctionInvoices : "AuctionId; Restrict"
    Customers ||..o{ AuctionInvoices : "CustomerId; Restrict"
    AuctionLot ||..o| AuctionInvoiceLines : "AuctionLotId; Restrict"
    AuctionInvoices ||..o{ AuctionInvoiceLines : "InvoiceId; Restrict"
    Bids ||..o| AuctionInvoiceLines : "WinningBidId; Restrict"
    AuctionLot ||..o{ Invoice : "AuctionLotId; Restrict"
    Customers ||..o{ Invoice : "CustomerId; Restrict"
    Bids ||..o{ Invoice : "WinningBidId; Restrict"
    AspNetRoles ||..o{ AspNetRoleClaims : "RoleId; Cascade"
    AspNetUsers ||..o{ AspNetUserClaims : "UserId; Cascade"
    AspNetUsers ||..o{ AspNetUserLogins : "UserId; Cascade"
    AspNetRoles ||--o{ AspNetUserRoles : "RoleId; Cascade"
    AspNetUsers ||--o{ AspNetUserRoles : "UserId; Cascade"
    AspNetUsers ||--o{ AspNetUserTokens : "UserId; Cascade"
