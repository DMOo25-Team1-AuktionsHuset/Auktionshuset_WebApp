<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Static SSR: NavigateTo performs the redirect instead of throwing NavigationException,
         matching interactive rendering and the .NET 10 project template default. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Auktionshuset.Contracts\Auktionshuset.Contracts.csproj" />
    <ProjectReference Include="..\Auktionshuset.Domain\Auktionshuset.Domain.csproj" />
  </ItemGroup>

</Project>
