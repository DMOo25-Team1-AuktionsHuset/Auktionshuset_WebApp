@page "/lager"
@rendermode InteractiveServer
@using Auktionshuset.Contracts.Dto.Admin.Lot
@using Auktionshuset.Models
@using System.Globalization

<PageTitle>Lager | Auktionshuset</PageTitle>

<section class="warehouse-page" aria-labelledby="warehouse-heading">
    <div class="warehouse-grid">
        <div class="lot-creation">
            <div class="page-heading">
                <p class="eyebrow">Lager</p>
                <h1 id="warehouse-heading">Tilføj genstand</h1>
                <p>Registrér et ny genstand, som skal indgå i auktionshusets lager.</p>
            </div>

            <EditForm EditContext="editContext" OnValidSubmit="SubmitAsync" class="lot-form" novalidate>
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div class="field field-wide">
                        <label for="lot-name">Navn</label>
                        <InputText id="lot-name" @bind-Value="model.Name" autocomplete="off" />
                        <ValidationMessage For="@(() => model.Name)" />
                    </div>

                    <div class="field">
                        <label for="lot-category">Kategori</label>
                        <InputText id="lot-category" @bind-Value="model.Category" autocomplete="off" />
                        <ValidationMessage For="@(() => model.Category)" />
                    </div>

                    <div class="field">
                        <label for="lot-quantity">Antal</label>
                        <InputNumber id="lot-quantity" @bind-Value="model.Quantity" min="1" />
                        <ValidationMessage For="@(() => model.Quantity)" />
                    </div>

                    <div class="field">
                        <label for="lot-value">Estimeret værdi</label>
                        <div class="input-suffix">
                            <InputNumber id="lot-value" @bind-Value="model.EstimatedValue" min="0.01" max="50000000" step="0.01" />
                            <span aria-hidden="true">DKK</span>
                        </div>
                        <ValidationMessage For="@(() => model.EstimatedValue)" />
                    </div>

                    <div class="field">
                        <label for="lot-auction-house">Auktionshus-id</label>
                        <InputText id="lot-auction-house" @bind-Value="model.AuctionHouseId" autocomplete="off" />
                        <ValidationMessage For="@(() => model.AuctionHouseId)" />
                    </div>

                    <div class="field field-wide">
                        <label for="lot-description">Beskrivelse</label>
                        <InputTextArea id="lot-description" @bind-Value="model.Description" rows="5" />
                        <ValidationMessage For="@(() => model.Description)" />
                    </div>

                    <div class="field field-wide">
                        <label for="lot-tags">Tags <span class="optional">(valgfrit)</span></label>
                        <InputText id="lot-tags" @bind-Value="model.Tags" aria-describedby="tags-help" autocomplete="off" />
                        <span id="tags-help" class="help-text">Adskil tags med komma. Dubletter fjernes automatisk. Maks. 20 tags.</span>
                        <ValidationMessage For="@(() => model.Tags)" />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="status-message @(submissionSucceeded ? "success" : "error")"
                         role="@(submissionSucceeded ? "status" : "alert")"
                         aria-live="polite">
                        @statusMessage
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner" aria-hidden="true"></span>
                            <span>Tilføjer...</span>
                        }
                        else
                        {
                            <span>Tilføj</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>

        <section class="lot-list" aria-labelledby="lot-list-heading" aria-busy="@isLoadingLots">
            <div class="list-heading">
                <p class="eyebrow">Oversigt</p>
                <h2 id="lot-list-heading">Alle lots</h2>
                <p>@lots.Count lot@(lots.Count == 1 ? string.Empty : "s") i lageret</p>
            </div>

            @if (isLoadingLots)
            {
                <p class="list-state" role="status">Henter lots...</p>
            }
            else if (!string.IsNullOrWhiteSpace(lotListError))
            {
                <p class="list-state list-error" role="alert">@lotListError</p>
            }
            else if (lots.Count == 0)
            {
                <p class="list-state">Der er endnu ingen lots i lageret.</p>
            }
            else
            {
                <ol class="lots">
                    @foreach (var lot in lots)
                    {
                        <li class="lot-card">
                            <div class="lot-card-header">
                                <div>
                                    <h3>@lot.Name</h3>
                                    <p>@lot.Category</p>
                                </div>
                                <strong>@lot.EstimatedValue.ToString("N2", CultureInfo.GetCultureInfo("da-DK")) DKK</strong>
                            </div>
                            <p class="lot-description">@lot.Description</p>
                            <dl class="lot-details">
                                <div>
                                    <dt>Antal</dt>
                                    <dd>@lot.Quantity stk.</dd>
                                </div>
                                <div>
                                    <dt>Auktionshus</dt>
                                    <dd title="@lot.AuctionHouseId">@lot.AuctionHouseId</dd>
                                </div>
                            </dl>
                            @if (lot.Tags.Count > 0)
                            {
                                <ul class="tags" aria-label="Tags">
                                    @foreach (var tag in lot.Tags)
                                    {
                                        <li>@tag</li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ol>
            }
        </section>
    </div>
</section>
