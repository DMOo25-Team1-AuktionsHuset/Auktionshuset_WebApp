@page "/"
@attribute [Authorize]
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Auktionshuset.Contracts.Security

<PageTitle>Haderslev Auktionshus</PageTitle>

<section class="home-page" aria-labelledby="home-heading">
    <div class="page-heading">
        <p class="eyebrow">Haderslev Auktionshus</p>
        <h1 id="home-heading">Administration af auktioner og genstande</h1>
        <p>Registrér genstande i lageret, og sammensæt dem til auktioner med auktionarius og tidspunkt.</p>
    </div>

    @if (Navigation.Uri.Contains("access=denied", StringComparison.OrdinalIgnoreCase))
    {
        <p class="access-notice" role="status">Du har ikke rettighed til den side eller handling.</p>
    }

    <div class="home-links">
        <AuthorizeView Policy="@FrontendPolicies.BillingStaff">
            <Authorized>
                <a class="card home-link" href="admin/invoices">
                    <h2>Betaling og afhentning</h2>
                    <p>Se fakturaer, registrér fuld betaling og udlever de betalte auktionslinjer.</p>
                    <span class="home-link-action">Gå til fakturaer</span>
                </a>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@FrontendPolicies.CanViewLots">
            <Authorized>
                <a class="card home-link" href="warehouse">
                    <h2>Lager</h2>
                    <p>Se genstandene på lageret og udfør de handlinger, dine rettigheder tillader.</p>
                    <span class="home-link-action">Gå til lageret</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@FrontendPolicies.CanViewAuctions">
            <Authorized>
                <a class="card home-link" href="admin/auctions">
                    <h2>Auktioner</h2>
                    <p>Opret auktioner, vælg genstande med antal, og følg oversigten.</p>
                    <span class="home-link-action">Gå til auktioner</span>
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@FrontendPolicies.CanViewEmployees">
            <Authorized>
                <a class="card home-link" href="admin/employees">
                    <h2>Medarbejdere</h2>
                    <p>Opret, redigér og slet medarbejdere, og administrér medarbejderoversigten.</p>
                    <span class="home-link-action">Gå til medarbejdere</span>
                </a>
            </Authorized>
        </AuthorizeView>
    </div>
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.IsInRole(RoleNames.Customer))
        {
            // Replace the history entry so the back button does not bounce customers
            // between the administration start page and their own area.
            Navigation.NavigateTo(AuthDestination.CustomerHome, forceLoad: true, replace: true);
        }
    }
}
