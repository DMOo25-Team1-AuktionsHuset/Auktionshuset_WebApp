@page "/warehouse"
@rendermode InteractiveServer
@using System.Globalization
@using Auktionshuset.Contracts.Dto.Admin.Lot

<PageTitle>Lager | Auktionshuset</PageTitle>

<section class="warehouse-page" aria-labelledby="warehouse-heading">
    <div class="page-heading">
        <p class="eyebrow">Lager</p>
        <h1 id="warehouse-heading">Genstande</h1>
        <p>Opret og vedligehold de genstande, der skal indgå i auktionshusets auktioner.</p>
    </div>

    <section class="card form-card" aria-labelledby="lot-form-heading">
        <div class="card-heading">
            <div>
                <h2 id="lot-form-heading">@(editingLotId.HasValue ? "Rediger genstand" : "Opret genstand")</h2>
                <p>
                    @if (editingLotId.HasValue)
                    {
                        <text>Du redigerer en genstand fra listen. Gem ændringerne, eller annullér for at rydde formularen.</text>
                    }
                    else
                    {
                        <text>Udfyld oplysningerne nedenfor og gem genstanden i lageret.</text>
                    }
                </p>
            </div>
            @if (editingLotId.HasValue)
            {
                <span class="badge badge-live mode-badge" role="status">Redigeringstilstand</span>
            }
        </div>

        <EditForm @key="editContext" EditContext="editContext" OnValidSubmit="SubmitAsync" class="lot-form" novalidate>
            <DataAnnotationsValidator />

            <div class="form-grid">
                <div class="field field-wide">
                    <label for="lot-name">Navn</label>
                    <InputText id="lot-name" @bind-Value="model.Name" autocomplete="off" />
                    <ValidationMessage For="@(() => model.Name)" />
                </div>

                <div class="field">
                    <label for="lot-category">Kategori</label>
                    <InputText id="lot-category" @bind-Value="model.Category" autocomplete="off" />
                    <ValidationMessage For="@(() => model.Category)" />
                </div>

                <div class="field">
                    <label for="lot-quantity">Antal</label>
                    <InputNumber id="lot-quantity" @bind-Value="model.Quantity" min="1" />
                    <ValidationMessage For="@(() => model.Quantity)" />
                </div>

                <div class="field">
                    <label for="lot-value">Estimeret værdi</label>
                    <div class="input-suffix">
                        <InputNumber id="lot-value" @bind-Value="model.EstimatedValue" min="0.01" max="50000000" step="0.01" />
                        <span aria-hidden="true">DKK</span>
                    </div>
                    <ValidationMessage For="@(() => model.EstimatedValue)" />
                </div>

                <div class="field field-wide">
                    <label for="lot-description">Beskrivelse</label>
                    <InputTextArea id="lot-description" @bind-Value="model.Description" rows="4" />
                    <ValidationMessage For="@(() => model.Description)" />
                </div>

                <div class="field field-wide">
                    <label for="lot-tags">Tags <span class="optional">(valgfrit)</span></label>
                    <InputText id="lot-tags" @bind-Value="model.Tags" aria-describedby="tags-help" autocomplete="off" />
                    <span id="tags-help" class="help-text">Adskil tags med komma. Dubletter fjernes automatisk. Maks. 20 tags.</span>
                    <ValidationMessage For="@(() => model.Tags)" />
                </div>

                <div class="field field-wide image-field">
                    <label for="lot-image">Billede <span class="optional">(valgfrit)</span></label>
                    <div class="image-picker">
                        <div class="image-preview">
                            @if (PreviewImageUrl is not null)
                            {
                                <img src="@PreviewImageUrl" alt="@($"Forhåndsvisning af billedet til {model.Name}")" />
                            }
                            else
                            {
                                <span class="image-preview-empty" aria-hidden="true">Intet billede valgt</span>
                            }
                        </div>

                        <div class="image-controls">
                            <InputFile id="lot-image"
                                       OnChange="OnImageSelectedAsync"
                                       accept="image/jpeg,image/jpg,image/png,image/webp"
                                       aria-describedby="image-help" />
                            <span id="image-help" class="help-text">JPEG, PNG eller WebP. Højst 5 MB.</span>

                            @if (PreviewImageUrl is not null)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="RemoveImage">
                                    Fjern billede
                                </button>
                            }

                            @if (!string.IsNullOrWhiteSpace(imageError))
                            {
                                <p class="validation-message" role="alert">@imageError</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="status-message @(submissionSucceeded ? "success" : "error")"
                     role="@(submissionSucceeded ? "status" : "alert")"
                     aria-live="polite">
                    @statusMessage
                </div>
            }

            <div class="form-actions">
                <button type="submit" class="btn" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>@(editingLotId.HasValue ? "Gemmer..." : "Opretter...")</span>
                    }
                    else
                    {
                        <span>@(editingLotId.HasValue ? "Gem ændringer" : "Opret genstand")</span>
                    }
                </button>

                @if (editingLotId.HasValue)
                {
                    <button type="button" class="btn btn-secondary" disabled="@isSubmitting" @onclick="CancelEdit">
                        Annuller redigering
                    </button>
                }
            </div>
        </EditForm>
    </section>

    <section class="card list-card" aria-labelledby="lot-list-heading" aria-busy="@(isLoadingLots ? "true" : "false")">
        <div class="card-heading list-heading">
            <div>
                <h2 id="lot-list-heading">Genstande i lageret</h2>
                <p>
                    @if (isLoadingLots)
                    {
                        <text>Henter genstande...</text>
                    }
                    else
                    {
                        <text>@FilteredLots.Count genstand@(FilteredLots.Count == 1 ? string.Empty : "e") fundet</text>
                    }
                </p>
            </div>

            <div class="list-tools">
                <div class="field search-field">
                    <label for="lot-search">Søg i genstande</label>
                    <input id="lot-search"
                           type="search"
                           placeholder="Navn, kategori, beskrivelse eller tags"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           @bind:after="OnSearchChanged" />
                </div>

                <div class="field page-size-field">
                    <label for="lot-page-size">Pr. side</label>
                    <select id="lot-page-size" @bind="pageSize" @bind:after="OnPageSizeChanged">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        @if (isLoadingLots)
        {
            <p class="list-state" role="status" aria-live="polite">Henter genstande...</p>
        }
        else if (!string.IsNullOrWhiteSpace(lotListError))
        {
            <p class="list-state list-error" role="alert">@lotListError</p>
        }
        else if (lots.Count == 0)
        {
            <p class="list-state">Der er endnu ingen genstande i lageret. Opret den første med formularen ovenfor.</p>
        }
        else if (FilteredLots.Count == 0)
        {
            <p class="list-state">Ingen genstande matcher søgningen &quot;@searchTerm&quot;.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="lot-table">
                    <caption class="visually-hidden">Genstande i lageret</caption>
                    <colgroup>
                        <col class="col-thumb" />
                        <col class="col-name" />
                        <col class="col-category" />
                        <col class="col-quantity" />
                        <col class="col-value" />
                        <col class="col-description" />
                        <col class="col-tags" />
                        <col class="col-actions" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col"><span class="visually-hidden">Billede</span></th>
                            <th scope="col">Navn</th>
                            <th scope="col">Kategori</th>
                            <th scope="col">Antal</th>
                            <th scope="col">Est. værdi</th>
                            <th scope="col">Beskrivelse</th>
                            <th scope="col">Tags</th>
                            <th scope="col">Handlinger</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lot in PagedLots)
                        {
                            var isSelected = editingLotId == lot.LotId;
                            var isExpanded = expandedLotIds.Contains(lot.LotId);

                            <tr class="@(isSelected ? "is-selected" : null)" @onclick="() => BeginEdit(lot)">
                                <td class="cell-thumb" data-label="Billede">
                                    @if (LotService.ResolveImageUrl(lot.ImageUrl) is { } thumbnailUrl)
                                    {
                                        <img class="lot-thumb" src="@thumbnailUrl" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="lot-thumb lot-thumb-empty" title="Intet billede" aria-label="Intet billede">
                                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                                                <rect x="3.5" y="5" width="17" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
                                                <path d="M4.5 15.5l4-4 3.5 3.5L15.5 11l4 4.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                                            </svg>
                                        </span>
                                    }
                                </td>

                                <td class="cell-name" data-label="Navn">
                                    <button type="button"
                                            class="row-activator"
                                            aria-pressed="@isSelected"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => BeginEdit(lot)">
                                        @lot.Name
                                    </button>
                                    @if (isSelected)
                                    {
                                        <span class="badge badge-live selected-badge">Redigeres</span>
                                    }
                                </td>

                                <td class="cell-category" data-label="Kategori">@lot.Category</td>

                                <td class="cell-quantity" data-label="Antal">@lot.Quantity stk.</td>

                                <td class="cell-value" data-label="Estimeret værdi">
                                    @lot.EstimatedValue.ToString("N2", DanishCulture) DKK
                                </td>

                                <td class="cell-description" data-label="Beskrivelse">
                                    <span class="clamp-text @(isExpanded ? "clamp-off" : null)" id="@($"lot-desc-{lot.LotId}")">@lot.Description</span>
                                </td>

                                <td class="cell-tags" data-label="Tags">
                                    @if (lot.Tags.Count == 0)
                                    {
                                        <span class="muted">Ingen</span>
                                    }
                                    else
                                    {
                                        <span class="clamp-tags @(isExpanded ? "clamp-off" : null)" id="@($"lot-tags-{lot.LotId}")">
                                            @foreach (var tag in lot.Tags)
                                            {
                                                <span class="tag">@tag</span>
                                            }
                                        </span>
                                    }
                                </td>

                                <td class="cell-actions" data-label="Handlinger">
                                    @if (pendingDeleteId == lot.LotId)
                                    {
                                        <div class="row-confirm" role="group" aria-label="@($"Bekræft sletning af {lot.Name}")">
                                            <span class="row-confirm-text">Slet genstanden?</span>
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    disabled="@isDeleting"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="ConfirmDeleteAsync">
                                                Ja, slet
                                            </button>
                                            <button type="button"
                                                    class="btn btn-secondary btn-sm"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="CancelDelete">
                                                Fortryd
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row-actions">
                                            <button type="button"
                                                    class="btn btn-secondary btn-sm"
                                                    aria-expanded="@isExpanded"
                                                    aria-controls="@($"lot-desc-{lot.LotId} lot-tags-{lot.LotId}")"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => ToggleExpanded(lot.LotId)">
                                                @(isExpanded ? "Vis mindre" : "Vis mere")
                                            </button>
                                            <button type="button"
                                                    class="btn btn-secondary btn-sm"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => BeginEdit(lot)">
                                                Rediger
                                            </button>
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => RequestDelete(lot.LotId)">
                                                Slet
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="pagination" aria-label="Sidenavigation for genstande">
                <button type="button" class="btn btn-secondary btn-sm" disabled="@(page <= 1)" @onclick="GoToPreviousPage">
                    Forrige
                </button>
                <p class="pagination-status" role="status" aria-live="polite">
                    Side @(page) af @TotalPages
                </p>
                <button type="button" class="btn btn-secondary btn-sm" disabled="@(page >= TotalPages)" @onclick="GoToNextPage">
                    Næste
                </button>
            </nav>
        }

        @if (!string.IsNullOrWhiteSpace(realtimeError))
        {
            <p class="list-state list-error" role="alert">@realtimeError</p>
        }
    </section>
</section>
