@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <div class="header-content">
            <NavLink href="/" class="brand" Match="NavLinkMatch.All">Auktionshuset</NavLink>
            <nav aria-label="Primær navigation">
                <NavLink href="warehouse" Match="NavLinkMatch.Prefix">Lager</NavLink>

                <details class="nav-group" open="@(IsAdministrationSection ? "open" : null)">
                    <summary class="nav-group-toggle @(IsAdministrationSection ? "active" : null)">
                        <span>Administration</span>
                        <span class="nav-group-chevron" aria-hidden="true"></span>
                    </summary>
                    <ul class="nav-sublist">
                        <li>
                            <NavLink href="admin/auctions/create" Match="NavLinkMatch.Prefix">Opret Auktion</NavLink>
                        </li>
                    </ul>
                </details>
            </nav>
        </div>
    </header>

    <main class="page-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
