@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <div class="header-content">
            <NavLink href="/" class="brand" Match="NavLinkMatch.All">
                <img class="brand-logo" src="images/logo.png" alt="" width="44" height="44" />
                <span class="brand-text">
                    <strong>Haderslev</strong>
                    <span>Auktionshus</span>
                </span>
            </NavLink>

            <nav class="primary-nav" aria-label="Primær navigation">
                <AuthorizeView Policy="@FrontendPolicies.CanViewLots">
                    <Authorized><NavLink href="warehouse" Match="NavLinkMatch.Prefix">Lager</NavLink></Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@FrontendPolicies.CanCreateAuction">
                    <Authorized><NavLink href="admin/auctions" Match="NavLinkMatch.Prefix">Auktioner</NavLink></Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@FrontendPolicies.Admin">
                    <Authorized><NavLink href="admin/employees" Match="NavLinkMatch.Prefix">Medarbejdere</NavLink></Authorized>
                </AuthorizeView>
            </nav>

            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="account-actions">
                        <span class="account-email">@authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
                        <form method="post" action="/auth/logout">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-secondary btn-sm">Log ud</button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="page-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Der er opstået en fejl.
    <a href="." class="reload">Genindlæs</a>
    <span class="dismiss">🗙</span>
</div>
