@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <div class="header-content">
            <NavLink href="/" class="brand" Match="NavLinkMatch.All">
                <img class="brand-logo" src="images/logo.png" alt="" width="44" height="44" />
                <span class="brand-text">
                    <strong>Haderslev</strong>
                    <span>Auktionshus</span>
                </span>
            </NavLink>

            <nav class="primary-nav" aria-label="Primær navigation">
                <NavLink href="warehouse" Match="NavLinkMatch.Prefix">Lager</NavLink>
                <NavLink href="admin/auctions" Match="NavLinkMatch.Prefix">Auktioner</NavLink>
            </nav>
        </div>
    </header>

    <main class="page-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Der er opstået en fejl.
    <a href="." class="reload">Genindlæs</a>
    <span class="dismiss">🗙</span>
</div>
