@inject NavigationManager Navigation
@using Auktionshuset.Contracts.Security

<p class="route-loading" role="status">Kontrollerer adgang...</p>

@code {
    [Parameter]
    public AuthenticationState AuthenticationState { get; set; } = default!;

    protected override void OnInitialized()
    {
        bool authenticated = AuthenticationState.User.Identity?.IsAuthenticated == true;
        string destination = !authenticated ? "/login"
            : AuthenticationState.User.IsInRole(RoleNames.Customer)
                ? AuthDestination.CustomerHome + "?access=denied"
                : "/?access=denied";
        Navigation.NavigateTo(destination, forceLoad: !authenticated);
    }
}
